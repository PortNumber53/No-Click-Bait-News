DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noclickbait
JWT_SECRET_KEY=your-jwt-secret-change-in-production
SEED_SAMPLE_ARTICLES=false

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_SECRET_THIN=whsec_your_thin_webhook_secret_here
STRIPE_WEBHOOK_SECRET_SNAPSHOT=whsec_your_snapshot_webhook_secret_here

TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_FETCH_ENDPOINT=https://api.fetch.tinyfish.ai
TINYFISH_FETCH_FORMAT=markdown
TINYFISH_FETCH_TTL=3600
TINYFISH_FETCH_TIMEOUT_MS=45000
NEWS_CRAWLER_FEEDS=
NEWS_CRAWLER_RSS_QUEUE_SIZE=100
NEWS_CRAWLER_RSS_WORKERS=2
NEWS_CRAWLER_URL_QUEUE_SIZE=250
NEWS_CRAWLER_FETCH_WORKERS=4
NEWS_CRAWLER_REWRITE_QUEUE_SIZE=250
NEWS_CRAWLER_REWRITE_WORKERS=2

LLM_API_KEY=your_openai_compatible_api_key_here
LLM_BASE_URL=http://your-freellmapi-host:30001/v1
LLM_MODEL=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000
LLM_REWRITE_WORKERS=2
LLM_REWRITE_QUEUE_SIZE=100
LLM_REWRITE_TIMEOUT_SECONDS=300
LLM_REWRITE_STALE_ON_START_LIMIT=100

ALLOWED_ORIGINS=http://localhost:21010
